# ==============================================================================
# GUTech LMS - Frontend Environment Variables
# ==============================================================================

# Base URL of the API (local: http://localhost:4000/api, production: https://gutech-lms-api.vercel.app/api)
VITE_API_URL=http://localhost:4000/api

# The browser never talks to Supabase directly: all data goes through the API,
# so no Supabase keys are needed here. Never put a service-role key in a VITE_ variable.
